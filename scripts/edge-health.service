[Unit]
Description=edge-machine bot health, status only (data/bot_health.json)
After=network-online.target polymarket-bot.service

[Service]
Type=oneshot
User=bot
Environment=EDGE_CLOSES_DIR=/home/bot/edge-machine-closes
Environment=EDGE_CLOSES_PY=/usr/bin/python3
Environment=ENGINE_DIR=/home/bot/polymarket-bot
Environment=ENGINE_UNIT=polymarket-bot
# Quoted: systemd splits an unquoted value on spaces and keeps only the first job. Not edge-health itself:
# systemd clears a unit's last exit while it runs, so it would always read "not run yet"; a stale
# published_at is how this job's own failure shows.
Environment="ENGINE_JOBS=edge-closes edge-kick bot-backup"
Environment=BACKUP_DIR=/home/bot/backups
# The LOW-balance threshold in dollars: set here only, never published.
Environment=BOT_HEALTH_LOW_USD=50
ExecStart=/home/bot/edge-machine-closes/scripts/vps_bot_health.sh
